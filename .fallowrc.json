{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",

  "ignorePatterns": [
    "packages/components/src/pages/**",
    "examples/**",
    "templates/**"
  ],

  "ignoreDependencies": [
    // jsconfig path aliases (packages/components): fallow does not resolve
    // tsconfig/jsconfig paths, so these look like unlisted packages.
    "@utils/*",
    "@components/*",
    "@pages/*",
    // Root monolith-publish dependencies (see
    // .plans/2026-10-25-1853-publish-only-sxo-findings-action-plan.md):
    // npm pack ships packages/{cli,server,client} under this root manifest, and npm
    // resolves the tarball's dependencies only from it — the nested @sxo/*
    // manifests are never installed (they are excluded from the tarball).
    // Fallow attributes each bare import to the workspace package that
    // declares it and cannot observe the pack contract, so it reports these
    // as unused here.
    "@sxo/cli",
    "alien-signals",
    "cac",
    "esbuild"
  ],

  // TestReactiveComponent exposes test bridges (testSetState, etc.) around
  // ReactiveComponent's protected API; tests call them via this.* inside
  // subclasses, which the class-member detector does not attribute across
  // inheritance (no tsconfig in this repo, so --type-aware stays unresolved).
  "usedClassMembers": [
    {
      "extends": "ReactiveComponent",
      "members": [
        "testSetState",
        "testGetState",
        "testConsumeContext",
        "testExposeContext",
        "testCompute",
        "testRefs"
      ]
    }
  ],

  "entry": [
    "packages/components/src/components/**"
  ],

  "dynamicallyLoaded": [
    "**/sxo.config.js",
    "**/sxo.config.ts",
    "packages/components/src/middleware.js",
    "packages/server/src/config/resolve-aliases.js",
    "packages/server/src/server/prod.js",
    "packages/server/src/server/prod/node.js",
    "packages/server/src/server/prod/bun.js",
    "packages/server/src/server/prod/deno.js",
    "scripts/test/test-coverage-report.js",
    "scripts/test/test-fail.js",
    "scripts/test/test-silent-report.js"
  ],

  // Fallow cannot connect these files to their real @utils/* alias importers.
  // Keep the exceptions file-scoped so other utility findings remain visible.
  "ignoreFindings": [
    "packages/components/src/utils/cn.js",
    "packages/components/src/utils/escape-html.js"
  ]
}
