{
    "name": "@sxo/server",
    "version": "0.10.1",
    "description": "SXO server runtime — dev/prod servers, SSR handler, config resolution, and platform adapters for Node.js, Bun, Deno, and Cloudflare Workers.",
    "keywords": [
        "sxo",
        "server-side-jsx",
        "ssr",
        "multi-runtime",
        "cloudflare-workers",
        "esbuild"
    ],
    "author": "Víctor García",
    "license": "MIT",
    "type": "module",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/gc-victor/sxo.git",
        "directory": "packages/server"
    },
    "homepage": "https://github.com/gc-victor/sxo#readme",
    "bugs": {
        "url": "https://github.com/gc-victor/sxo/issues"
    },
    "files": [
        "src",
        "!src/**/*.test.js",
        "!src/**/test-utils.js",
        "!src/**/*.test-utils.js"
    ],
    "exports": {
        ".": "./src/server/dev.js",
        "./runtime": "./src/runtime/handler.js",
        "./cloudflare": "./src/server/prod/cloudflare.js",
        "./dev-node": "./src/server/dev/node.js",
        "./dev-bun": "./src/server/dev/bun.js",
        "./dev-deno": "./src/server/dev/deno.js",
        "./config": "./src/config/resolve.js",
        "./config/aliases": "./src/config/aliases.js",
        "./constants": "./src/constants.js",
        "./shared/runtime": "./src/server/shared/runtime.js",
        "./shared/file-readers": "./src/server/shared/file-readers.js",
        "./utils/route-match": "./src/server/utils/route-match.js",
        "./generate": "./src/generate/generate.js"
    },
    "dependencies": {
        "pino": "^10.3.1",
        "pino-http": "^11.0.0",
        "pino-pretty": "^13.1.3"
    }
}
