{
    "name": "@sxo/components",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "description": "A complete set of ready-to-use UI components built for SXO.",
    "license": "MIT",
    "scripts": {
        "check": "biome check src/ e2e/",
        "check:fix": "biome check --write --unsafe src/ e2e/",
        "copy:public": "cp -r src/public dist/client",
        "dev": "pnpm run \"/^(tailwind:watch|sxo:dev)$/\"",
        "server": "pnpm run sxo:clean -y && pnpm run tailwind:style-packs && pnpm run sxo:build && pnpm run sxo:start",
        "sxo:help": "sxo --help",
        "sxo:dev": "sxo clean -y && pnpm run tailwind:style-packs && sxo dev",
        "sxo:build": "pnpm run tailwind && pnpm run tailwind:style-packs && sxo build",
        "sxo:generate": "sxo generate",
        "sxo:start": "sxo start --port 3001",
        "sxo:clean": "sxo clean",
        "playwright:install": "playwright install chromium --with-deps",
        "test:e2e": "playwright test --workers 4",
        "test:e2e:ui": "playwright test --ui",
        "test:e2e:headed": "playwright test --headed",
        "test:e2e:debug": "playwright test --debug",
        "test:e2e:server": "sxo clean --yes && pnpm run tailwind:style-packs && NODE_ENV=test sxo build && sxo start --port ${PORT:-3002}",
        "tailwind": "tailwindcss -i src/styles.css -o src/pages/global.css --minify",
        "tailwind:style-vega": "tailwindcss -i src/style-packs/vega.css -o dist/client/styles/vega.css --minify",
        "tailwind:style-nova": "tailwindcss -i src/style-packs/nova.css -o dist/client/styles/nova.css --minify",
        "tailwind:style-maia": "tailwindcss -i src/style-packs/maia.css -o dist/client/styles/maia.css --minify",
        "tailwind:style-lyra": "tailwindcss -i src/style-packs/lyra.css -o dist/client/styles/lyra.css --minify",
        "tailwind:style-mira": "tailwindcss -i src/style-packs/mira.css -o dist/client/styles/mira.css --minify",
        "tailwind:style-luma": "tailwindcss -i src/style-packs/luma.css -o dist/client/styles/luma.css --minify",
        "tailwind:style-sera": "tailwindcss -i src/style-packs/sera.css -o dist/client/styles/sera.css --minify",
        "tailwind:style-rhea": "tailwindcss -i src/style-packs/rhea.css -o dist/client/styles/rhea.css --minify",
        "tailwind:style-packs": "pnpm run tailwind:style-vega & pnpm run tailwind:style-nova & pnpm run tailwind:style-maia & pnpm run tailwind:style-lyra & pnpm run tailwind:style-mira & pnpm run tailwind:style-luma & pnpm run tailwind:style-sera & pnpm run tailwind:style-rhea & wait",
        "tailwind:watch": "pnpm run tailwind --watch"
    },
    "dependencies": {
        "@sxo/client": "workspace:*",
        "turndown": "^7.2.4"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.4.11",
        "@playwright/test": "^1.59.1",
        "@sxo/cli": "workspace:*",
        "@tailwindcss/cli": "4.2.2",
        "basecoat-css": "1.0.2",
        "tailwindcss": "4.2.2"
    }
}
