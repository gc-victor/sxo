{
    "compilerOptions": {
        "checkJs": true,
        "allowJs": true,
        "lib": ["ESNext", "DOM"],
        "types": ["node", "deno", "bun"],
        "paths": {
            "#cli/*": ["./packages/cli/src/cli/*"],
            "#config": ["./packages/server/src/config/*"],
            "#server/*": ["./packages/server/src/server/*"],
            "#runtime/*": ["./packages/server/src/runtime/*"],
            "#esbuild/*": ["./packages/cli/src/esbuild/*"]
        },
        "module": "esnext",
        "target": "esnext",
        "moduleDetection": "force",
        "noImplicitAny": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "exactOptionalPropertyTypes": true,
        "strictNullChecks": true,
        "strictFunctionTypes": false,
        "strictPropertyInitialization": false,
        "strictBindCallApply": false,
        "strict": true,
        "noEmit": true,
        "composite": true,
        "skipLibCheck": true,
        "jsx": "preserve",
        "jsxFactory": "jsx",
        "jsxFragmentFactory": "Fragment",
        "allowSyntheticDefaultImports": true,
        "forceConsistentCasingInFileNames": true,
        "typeRoots": ["./node_modules/@types", "./packages/server/src/types"]
    },
    "include": ["packages/cli/src/**/*", "packages/server/src/**/*", "packages/client/src/**/*", "packages/cli/jsx-transformer/src/lib.rs"],
    "exclude": ["node_modules", "dist/**/*", "**/*.test.js"]
}
