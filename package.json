{
    "name": "sxo",
    "version": "0.10.1",
    "description": "SXO — Server-side JSX framework and CLI. Directory-based routing, hot replace, static generation, component library, and a Rust/WASM JSX transformer. Runs on Node.js, Bun, Deno, and Cloudflare Workers.",
    "keywords": [
        "sxo",
        "server-side-jsx",
        "ssx",
        "esbuild",
        "jsx",
        "wasm",
        "hot-replace",
        "cli",
        "static-site",
        "ssr"
    ],
    "author": "Víctor García",
    "license": "MIT",
    "type": "module",
    "exports": {
        ".": "./packages/cli/bin/sxo.js",
        "./client": {
            "types": "./packages/client/src/index.ts",
            "default": "./packages/client/src/index.ts"
        },
        "./runtime": "./packages/server/src/runtime/handler.js",
        "./cloudflare": "./packages/server/src/server/prod/cloudflare.js",
        "./dev-node": "./packages/server/src/server/dev/node.js",
        "./dev-bun": "./packages/server/src/server/dev/bun.js",
        "./dev-deno": "./packages/server/src/server/dev/deno.js",
        "./server/config": "./packages/server/src/config/resolve.js",
        "./server/config/aliases": "./packages/server/src/config/aliases.js",
        "./server/constants": "./packages/server/src/constants.js",
        "./server/shared/runtime": "./packages/server/src/server/shared/runtime.js",
        "./server/shared/file-readers": "./packages/server/src/server/shared/file-readers.js",
        "./server/utils/route-match": "./packages/server/src/server/utils/route-match.js",
        "./server/generate": "./packages/server/src/generate/generate.js"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/gc-victor/sxo.git"
    },
    "homepage": "https://github.com/gc-victor/sxo#readme",
    "bugs": {
        "url": "https://github.com/gc-victor/sxo/issues"
    },
    "bin": {
        "sxo": "packages/cli/bin/sxo.js"
    },
    "engines": {
        "node": ">=20"
    },
    "scripts": {
        "help": "sxo --help",
        "wasm-build": "node scripts/wasm-build.js",
        "format": "biome format packages/cli/src packages/server/src packages/client/src packages/client/tests --write",
        "check": "biome check packages/cli/src packages/server/src packages/client/src packages/client/tests packages/components/e2e packages/components/src",
        "check:fix": "biome check --write --unsafe packages/cli/src packages/server/src packages/client/src packages/client/tests packages/components/e2e packages/components/src",
        "components:dev": "pnpm run --filter ./packages/components dev",
        "components:build": "pnpm run --filter ./packages/components sxo:build",
        "components:start": "pnpm run --filter ./packages/components sxo:start",
        "components:clean": "pnpm run --filter ./packages/components sxo:clean",
        "components:install": "pnpm run --filter ./packages/components install --frozen-lockfile",
        "components:playwright:install": "pnpm run --filter ./packages/components playwright:install",
        "test": "node scripts/test/test.js",
        "test:bench": "node scripts/test/test-benchmark.js",
        "test:coverage": "node scripts/test/test.js coverage",
        "test:lcov": "node scripts/test/test.js lcov",
        "test:e2e": "pnpm run --filter ./packages/components test:e2e",
        "test:client": "pnpm run --filter @sxo/client test",
        "test:client:watch": "pnpm run --filter @sxo/client test:watch",
        "test:runtimes": "bash scripts/test-runtimes.sh",
        "knip": "knip"
    },
    "dependencies": {
        "alien-signals": "^3.2.1",
        "cac": "^7.0.0",
        "esbuild": "^0.28.0",
        "pino": "^10.3.1",
        "pino-http": "^11.0.0",
        "pino-pretty": "^13.1.3"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.4.15",
        "@types/bun": "^1.3.13",
        "@types/deno": "^2.5.0",
        "@types/node": "^25.6.2",
        "knip": "^6.12.2",
        "typescript": "^6.0.3"
    }
}
